{
  "compilerOptions": {
    "target": "ES2018", // ~node10
    "module": "commonjs",
    "lib": [
      "es2015",
      "es2016",
      "es2017",
      "es2018"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    // Homebridge v2 bundles Matter (@matter/*) type declarations that use
    // newer TypeScript syntax. We never reference them, but tsc parses the
    // dependency type graph; skipping lib checks keeps builds green against
    // both v1 and v2 of homebridge without forcing a TS upgrade.
    "skipLibCheck": true
  },
  "include": [
    "src/"
  ],
  "exclude": [
    "**/*.spec.ts"
  ]
}
